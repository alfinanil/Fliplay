{
  "info": {
    "name": "FlipPlay API - Modul 4",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000/api"
    }
  ],
  "item": [
    {
      "name": "1. Media - Happy path",
      "item": [
        {
          "name": "GET semua media (200)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/media",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "media"
              ]
            }
          }
        },
        {
          "name": "GET cari judul (200)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/media?judul=a&jenis=film",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "media"
              ],
              "query": [
                {
                  "key": "judul",
                  "value": "a"
                },
                {
                  "key": "jenis",
                  "value": "film"
                }
              ]
            }
          }
        },
        {
          "name": "POST tambah media (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/media",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "media"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"judul\": \"Laskar Pelangi\",\n  \"jenis\": \"film\",\n  \"genre\": \"Drama\",\n  \"tahun_rilis\": 2008,\n  \"deskripsi\": \"Kisah anak-anak Belitung\"\n}"
            }
          }
        },
        {
          "name": "GET detail media + pengguna (200)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
